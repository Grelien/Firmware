# ==============================================================================
# 1. Build Artifacts and Compilation Outputs
# ==============================================================================
# The main build output directory
/build/

# SDK configuration files generated/modified during build
/sdkconfig
/sdkconfig.defaults.old
/sdkconfig.old

# Intermediate compilation files
*.o         # Object files
*.obj       # Object files 
*.d         # Dependency files
*.elf       # Final ELF executable 
*.bin       # Final binary image
*.map       # Linker map files
*.lst       # Listing files

# CMake-related temporary files
CMakeCache.txt
CMakeFiles/
install_manifest.txt
cmake_install.cmake

# ==============================================================================
# 2. IDE / Editor Specific Files
# ==============================================================================
# Visual Studio Code (VS Code) specific configuration
/.vscode/

.idea/

# Eclipse
.project
.cproject
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim swap files
*~
*.swp
.netmf_proj

# Platform-specific temporary/metadata files
.DS_Store    # macOS
Thumbs.db    # Windows
ehthumbs.db  # Windows
Desktop.ini  # Windows

# ==============================================================================
# 3. Virtual Environments and Python Specifics
# ==============================================================================
# Python virtual environments (if created in the project root)
/venv/
.env/

# Python compiled files
*.pyc
__pycache__/

# ==============================================================================
# 4. Runtime / Log / Cache Files
# ==============================================================================
# Log files generated by your application or tools
*.log

# Cache directories
*.cache/

# Core dump files 
core
*.core

